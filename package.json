{
  "name": "neurobridge-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chat module for an AI-imposter social-deduction game",
  "engines": { "node": ">=22.9" },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env server/src/index.ts",
    "start": "tsx --env-file-if-exists=.env server/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/simulate.ts",
    "logs:export": "tsx scripts/export.ts",
    "logs:summary": "tsx scripts/summary.ts",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build"
  },
  "dependencies": {
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

# Copy to .env (gitignored, never served to browsers). Both providers are optional:
# without keys the game falls back to the built-in bots and answers.

# Meeting question answers for the AI impostors (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# AI impostor movement decisions (Groq, OpenAI-compatible)
GROQ_API_KEY=
# llama-3.1-8b-instant is no longer available on Groq; this is the closest fast model
GROQ_MODEL=openai/gpt-oss-20b
# Groq rate limits per minute (free tier is tight; raise on a paid plan)
GROQ_RPM=24
GROQ_TPM=7000

# 1 = print every director decision in the server log
DIRECTOR_DEBUG=0
LOG_DIR=logs

# --- server ---
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# --- LLM (server side only, never sent to clients) ---
# mock | gemini | anthropic | openai   (openai = any OpenAI-compatible /chat/completions endpoint)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
# only for provider=openai, e.g. https://api.openai.com/v1
LLM_BASE_URL=
LLM_TIMEOUT_MS=12000

# --- chat rules ---
TURN_MS=30000
QUESTION_DELAY_MS=2500
INTER_TURN_MS=700
DISCONNECT_GRACE_MS=5000
ANSWER_MAX_CHARS=200
ALLOW_DEAD_SPECTATORS=false

# --- analytics ---
LOG_DIR=logs

# --- dev harness (server/src/index.ts only) ---
DEV_ROOM=dev
DEV_LANGUAGE=en
DEV_AI_COUNT=1
DEV_AI_LEVEL=3
DEV_MIN_HUMANS=1
DEV_ROUND_GAP_MS=6000
